# Copy to extension/.env.production (note the leading dot) and fill in. `npm --prefix extension run build` reads it.
# Same two values as the dashboard. Public by design; NEVER use the service_role / secret key (the build refuses it).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
