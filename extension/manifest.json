{
  "manifest_version": 3,
  "name": "CheatNoNo",
  "version": "0.1.0",
  "description": "Anti-cheat companion for Google Forms exams.",
  "minimum_chrome_version": "110",
  "permissions": ["tabs", "storage", "idle", "identity", "identity.email", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "src/background/background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/forms/*"],
      "js": ["src/content/styles.js", "src/content/ui.js", "src/content/content.js"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_title": "CheatNoNo (dev panel)", "default_popup": "src/popup/popup.html" },
  "web_accessible_resources": [
    { "resources": ["src/blocked/blocked.html"], "matches": ["<all_urls>"] }
  ]
}
